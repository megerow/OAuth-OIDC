{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Idp": {
    "AuthenticationMode": "Persona",
    "EnableAdminUi": false,
    "AdminGroup": "",
    "Issuer": "",
    "AllowDynamicClientRegistration": true,
    "Clients": [
      {
        "ClientId": "my_learning_client_app",
        "RedirectUris": [ "http://localhost:8080/callback/" ],
        "PostLogoutRedirectUris": [ "http://localhost:8080/" ]
      }
    ],
    "RoleMappings": [
      { "Group": "DEMO\\App-Admins", "Role": "Admin" },
      { "Group": "DEMO\\App-Billing", "Role": "BillingManager" }
    ],
    "Personas": [
      {
        "Email": "jane.doe@example.com",
        "Password": "password123",
        "Name": "Jane Doe",
        "Sid": "S-1-5-21-1000000001-2000000002-3000000003-1001",
        "Groups": [ "DEMO\\Domain Users", "DEMO\\App-Admins", "DEMO\\App-Billing" ]
      },
      {
        "Email": "john.smith@example.com",
        "Password": "password123",
        "Name": "John Smith",
        "Sid": "S-1-5-21-1000000001-2000000002-3000000003-1002",
        "Groups": [ "DEMO\\Domain Users", "DEMO\\App-Billing" ]
      }
    ]
  },
  "Tokens": {
    "AccessTokenSeconds": 3600,
    "RefreshTokenSeconds": 86400,
    "RefreshTokenMaxSeconds": 604800,
    "AuthorizationCodeSeconds": 300
  },
  "Persistence": {
    "Provider": "None",
    "ConnectionString": "",
    "EncryptionKey": "",
    "AutoMigrate": true,
    "SigningKeyRotationDays": 90,
    "SigningKeyRetentionDays": 7,
    "CleanupIntervalSeconds": 600
  }
}
